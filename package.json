{
  "name": "xygeni-scanner-vscode",
  "displayName": "Xygeni Security for VSCode",
  "description": "Secure your codebase with Secrets, SAST, SCA, IaC, Code Quality, API Security, AI Security, Malware & Supply Chain scanning",
  "publisher": "xygeni-security",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xygeni/vscode-extension"
  },
  "icon": "media/images/logo_xy.png",
  "version": "1.2.11",
  "engines": {
    "vscode": "^1.99.2"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xygeni",
          "title": "Xygeni",
          "icon": "media/images/xy_icon_white.svg"
        }
      ]
    },
    "views": {
      "xygeni": [
        {
          "id": "xygeni.views.welcome",
          "name": "Xygeni",
          "when": "xygeni:welcome || !xygeni:workspaceFound || xygeni:error",
          "icon": "media/images/xy_icon_white.svg"
        },
        {
          "id": "xygeni.views.configuration",
          "name": "Configuration",
          "type": "webview",
          "when": "!xygeni:welcome && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.sast",
          "name": "SAST",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.sca",
          "name": "SCA",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.cicd",
          "name": "CI/CD",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.secrets",
          "name": "Secrets",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.iac",
          "name": "IaC",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.quality",
          "name": "Code Quality",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.apisec",
          "name": "API Security",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.ai",
          "name": "AI Security",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.malware",
          "name": "Malware",
          "when": "xygeni:scannerResults && xygeni:workspaceFound"
        },
        {
          "id": "xygeni.views.help",
          "name": "Xygeni Docs & Help",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xygeni.views.welcome",
        "contents": "# Welcome to Xygeni!.\n\n Connect to your Xygeni account to get started.\n\n[Connect to Xygeni API & Scanner](command:xygeni.showConfig)",
        "when": "xygeni:welcome"
      },
      {
        "view": "xygeni.views.welcome",
        "contents": "# Welcome to Xygeni!.\n\n Select a workspace to run Xygeni Scans.\n\n",
        "when": "!xygeni:workspaceFound"
      },
      {
        "view": "xygeni.views.welcome",
        "contents": "There is an error with Xygeni extension.\n\n[Show Output](command:xygeni.openConnectionOutput)",
        "when": "xygeni:error"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "xygeni.showConfig",
          "when": "view == 'xygeni.views.welcome'",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.run",
          "when": "view == 'xygeni.views.configuration' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.openSettings",
          "when": "view == 'xygeni.views.configuration'",
          "group": "navigation"
        },
        {
          "command": "xygeni.showOutput",
          "when": "view == 'xygeni.views.configuration'",
          "group": "navigation"
        },
        {
          "command": "xygeni.showScanOutput",
          "when": "view == 'xygeni.views.configuration'",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.sast",
          "when": "view == 'xygeni.views.sast' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.deps",
          "when": "view == 'xygeni.views.sca' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.misconf",
          "when": "view == 'xygeni.views.cicd' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.secrets",
          "when": "view == 'xygeni.views.secrets' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.iac",
          "when": "view == 'xygeni.views.iac' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.quality",
          "when": "view == 'xygeni.views.quality' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.apisec",
          "when": "view == 'xygeni.views.apisec' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.ai",
          "when": "view == 'xygeni.views.ai' && xygeni:installReady",
          "group": "navigation"
        },
        {
          "command": "xygeni.scan.runOnly.malware",
          "when": "view == 'xygeni.views.malware' && xygeni:installReady",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "xygeni.scan.selectAllScanTypes",
          "when": "false"
        },
        {
          "command": "xygeni.scan.removeExclude",
          "when": "false"
        },
        {
          "command": "xygeni.scan.removeOption",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "xygeni.showConfig",
        "title": "Xygeni: Open Configuration",
        "icon": "$(debug-configure)"
      },
      {
        "command": "xygeni.openProxyConfig",
        "title": "Xygeni: Open Proxy Configuration",
        "icon": "$(debug-configure)"
      },
      {
        "command": "xygeni.openSettings",
        "title": "Xygeni: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "xygeni.closeConfig",
        "title": "Xygeni: Close Configuration",
        "icon": "$(close)"
      },
      {
        "command": "xygeni.config.editUrl",
        "title": "Edit URL"
      },
      {
        "command": "xygeni.config.editToken",
        "title": "Edit Token"
      },
      {
        "command": "xygeni.config.testConnection",
        "title": "Test Connection"
      },
      {
        "command": "xygeni.scan.install",
        "title": "Install Scanner"
      },
      {
        "command": "xygeni.scan.run",
        "title": "Run Scanner",
        "icon": "$(play)"
      },
      {
        "command": "xygeni.showOutput",
        "title": "View Extension Output",
        "icon": "$(output)"
      },
      {
        "command": "xygeni.showScanOutput",
        "title": "View Scanner Output",
        "icon": "$(output)"
      },
      {
        "command": "xygeni.scan.openIssue",
        "title": "Open Issue"
      },
      {
        "command": "xygeni.scan.openIssueInEditor",
        "title": "Open Issue in Editor"
      },
      {
        "command": "xygeni.showMcpSetup",
        "title": "Xygeni: Show Xygeni MCP Server Setup Guide"
      },
      {
        "command": "xygeni.mcp.checkUpdates",
        "title": "Xygeni: Check for MCP Server Updates"
      },
      {
        "command": "xygeni.scan.selectAllScanTypes",
        "title": "Select all scan types",
        "icon": "$(check-all)"
      },
      {
        "command": "xygeni.scan.restoreDefaults",
        "title": "Xygeni: Restore the default scan configuration",
        "icon": "$(discard)"
      },
      {
        "command": "xygeni.scan.openConfigFile",
        "title": "Xygeni: Open the scan configuration file (.xygeni/ide.json)"
      },
      {
        "command": "xygeni.scan.addExcludeFolder",
        "title": "Xygeni: Exclude a folder from the scan",
        "icon": "$(folder-opened)"
      },
      {
        "command": "xygeni.scan.addExcludePattern",
        "title": "Xygeni: Exclude a pattern from the scan",
        "icon": "$(add)"
      },
      {
        "command": "xygeni.scan.removeExclude",
        "title": "Stop excluding",
        "icon": "$(close)"
      },
      {
        "command": "xygeni.scan.addOption",
        "title": "Add Scanner Option",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.removeOption",
        "title": "Remove Scanner Option",
        "icon": "$(close)"
      },
      {
        "command": "xygeni.scan.runOnly.sast",
        "title": "Run SAST Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.deps",
        "title": "Run SCA Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.misconf",
        "title": "Run CI/CD Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.secrets",
        "title": "Run Secrets Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.iac",
        "title": "Run IaC Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.quality",
        "title": "Run Code Quality Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.apisec",
        "title": "Run API Security Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.ai",
        "title": "Run AI Security Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      },
      {
        "command": "xygeni.scan.runOnly.malware",
        "title": "Run Malware Scan",
        "icon": "$(play)",
        "category": "Xygeni"
      }
    ],
    "configuration": [
      {
        "id": "xygeni",
        "title": "Xygeni Security",
        "properties": {}
      },
      {
        "order": 1,
        "id": "api",
        "title": "Connection & Authentication",
        "properties": {
          "xygeni.api.xygeniUrl": {
            "order": 1,
            "type": "string",
            "default": "",
            "description": "URL of the Xygeni API server"
          },
          "xygeni.api.xygeniToken": {
            "order": 2,
            "type": "string",
            "enum": [
              "Use Xygeni Configuration to store Xygeni Token as a secret"
            ],
            "default": "Use Xygeni Configuration to store Xygeni Token as a secret",
            "markdownDescription": "Authentication token for the Xygeni API server"
          },
          "xygeni.api.allowInsecureHttp": {
            "order": 3,
            "type": "boolean",
            "scope": "application",
            "default": false,
            "markdownDescription": "Allow a server URL that uses `http://` to a host other than localhost. The API token then travels in clear on every request, so leave this off unless the Xygeni server really has no TLS. `http://localhost` is always allowed."
          }
        }
      },
      {
        "order": 2,
        "id": "proxy",
        "title": "Proxy Configuration",
        "properties": {
          "xygeni.proxy.protocol": {
            "order": 1,
            "type": "string",
            "enum": [
              "http",
              "socks"
            ],
            "default": "http",
            "description": "Proxy protocol."
          },
          "xygeni.proxy.host": {
            "order": 2,
            "type": "string",
            "default": "",
            "description": "Proxy host. Empty for no proxy."
          },
          "xygeni.proxy.port": {
            "order": 3,
            "type": "number",
            "default": 3128,
            "description": "Proxy port."
          },
          "xygeni.proxy.authentication": {
            "order": 4,
            "type": "string",
            "enum": [
              "none",
              "basic"
            ],
            "default": "none",
            "description": "Authentication to proxy."
          },
          "xygeni.proxy.username": {
            "order": 5,
            "type": "string",
            "default": "",
            "description": "Proxy username. Ignored with authentication=none."
          },
          "xygeni.proxy.password": {
            "order": 6,
            "type": "string",
            "default": "",
            "description": "Proxy password. Ignored with authentication=none."
          },
          "xygeni.proxy.nonProxyHosts": {
            "order": 7,
            "type": "string",
            "default": "",
            "description": "A bar-separated (|) list of hostnames that should bypass the proxy."
          }
        }
      },
      {
        "order": 3,
        "id": "scan",
        "title": "Scan Settings",
        "properties": {
          "xygeni.scan.autoScan": {
            "order": 1,
            "type": "boolean",
            "default": false,
            "description": "Automatically run an incremental scan when a file is saved."
          },
          "xygeni.scan.skipSslVerify": {
            "scope": "machine",
            "order": 2,
            "type": "boolean",
            "default": false,
            "markdownDescription": "Disable SSL certificate validation in the Xygeni scanner (`--skip-ssl-verify`). Enable it only when the scan fails with certificate errors because a corporate proxy inspects TLS traffic and re-signs it with an internal CA. **This reduces transport security: use it only in trusted networks.**"
          },
          "xygeni.scan.skipUpdate": {
            "scope": "machine",
            "order": 3,
            "type": "boolean",
            "default": false,
            "markdownDescription": "Do not update the Xygeni scanner before running it (`--skip-update`). Useful when the update download is blocked or slow. **You may run an outdated scanner version.**"
          },
          "xygeni.scan.verbose": {
            "scope": "machine",
            "order": 4,
            "type": "boolean",
            "default": false,
            "markdownDescription": "Verbose scanner output in the Xygeni Scanner output channel (`--verbose`), for troubleshooting."
          },
          "xygeni.scan.additionalGlobalOptions": {
            "scope": "machine",
            "order": 5,
            "type": "string",
            "default": "",
            "markdownDescription": "Advanced: extra global options for the Xygeni scanner, placed before the command (`xygeni <options> scan ...`). Separate them with spaces. Example: `-cop key=value`. Leave empty unless Xygeni support asks for it. `-q`/`--quiet` (the extension reads the scanner output) and `--api-key` (the token comes from the Xygeni configuration) are ignored."
          }
        }
      },
      {
        "order": 4,
        "id": "mcp",
        "title": "MCP Server",
        "properties": {
          "xygeni.mcp.updates": {
            "scope": "machine",
            "order": 1,
            "type": "string",
            "enum": [
              "notify",
              "auto",
              "off"
            ],
            "enumDescriptions": [
              "Notify when a newer Xygeni MCP server is published, with Update and Ignore this version actions.",
              "Download and install the newer Xygeni MCP server in the background, and notify when done.",
              "Never check. The command Xygeni: Check for MCP Server Updates still works."
            ],
            "default": "notify",
            "markdownDescription": "What to do when a newer Xygeni MCP server is published. The published version is checked once a day after the connection is validated; the installed JAR lives in `~/.xygeni/mcp/xygeni-mcp-server.jar`, shared with the other Xygeni IDE plugins."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "cleanup": "rm -rf ./out",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "rebuild": "rm -rf ./out && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npx --yes @vscode/vsce package --allow-missing-repository",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run cleanup && npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test --label e2e",
    "copy-test-data": "cp -r src/test/unit/issues.test.data out/test/unit/",
    "test:unit": "npm run pretest && npm run copy-test-data && mocha --ui tdd -c 'out/test/unit/**/*.test.js'",
    "test:real": "npm run pretest && vscode-test --label real"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.99.2",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "0.25.3",
    "eslint": "9.25.1",
    "mocha": "11.7.1",
    "sinon": "21.0.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "https-proxy-agent": "7.0.6",
    "lodash": "4.18.0",
    "marked": "16.2.1",
    "yauzl": "3.2.1"
  }
}
